# FORGE Server — configuração de instalação
# Copie para .env e ajuste conforme o ambiente:
#   cp .env.example .env

# Rede PXE
SERVER_IP=192.168.100.1
PXE_NETWORK=192.168.100.0/24
SERVER_PORT=8080

# Storage
HOT_CACHE_PATH=/mnt/hot
COLD_STORAGE_PATH=/mnt/cold
HOT_CACHE_LABEL=forge-hot
COLD_STORAGE_LABEL=forge-cold
# Modo de storage: simple (path unico) | hot_cold (hot cache + cold storage sem RAID) | hot_cold_raid (padrao)
STORAGE_MODE=hot_cold_raid

# Portas de debug (netcat)
DEBUG_PORT_IN=9997
DEBUG_PORT_NC_IN=9998
DEBUG_PORT_NC_OUT=9999

# Banco de dados - TROCAR [PASSWORD] PELA SENHA REAL, SEM COLCHETES []
DATABASE_URL=postgresql+asyncpg://forge:[PASSWORD]@localhost/forge